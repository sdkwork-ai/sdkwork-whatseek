.denied-glyph { font-size: 88rpx; margin-bottom: 16rpx; }
.runner-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 32rpx 0;
}
.runner-name { font-size: 28rpx; font-weight: 500; }
.runner-live { display: flex; align-items: center; gap: 8rpx; font-size: 22rpx; color: var(--sdk-color-success); }
.runner-body { display: flex; flex-direction: column; align-items: center; padding: 48rpx 64rpx; }
.runner-icon { font-size: 96rpx; }
.runner-title { margin-top: 16rpx; font-size: 30rpx; font-weight: 500; }
.runner-note { margin-top: 12rpx; font-size: 24rpx; color: var(--sdk-color-text-muted); text-align: center; }
.runner-frame {
  width: 100%;
  margin-top: 40rpx;
  padding: 32rpx;
  border: 1rpx solid var(--sdk-color-border-subtle);
  border-radius: 24rpx;
  background-color: var(--sdk-color-surface-panel);
}
.runner-line { height: 24rpx; border-radius: 8rpx; background-color: var(--sdk-color-surface-muted); margin-bottom: 16rpx; }
.w-half { width: 50%; }
.w-full { width: 100%; }
.w-3of4 { width: 75%; }
.runner-cta { height: 72rpx; border-radius: 16rpx; background-color: var(--sdk-color-brand-soft); margin-top: 24rpx; }
