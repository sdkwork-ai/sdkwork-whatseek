<view wx:if="{{loading}}" class="state">{{t.runner.opening}}</view>

<view wx:elif="{{denied}}" class="state">
  <view class="denied-glyph">🔒</view>
  <view class="state-title">{{t.runner.deniedTitle}}</view>
  <view class="state-desc">{{t.runner.deniedPrefix}}{{appName}}{{t.runner.deniedSuffix}}</view>
  <button class="retry-btn" bindtap="onBack">{{t.runner.back}}</button>
</view>

<view wx:elif="{{error}}" class="state">
  <view class="state-title">{{t.detail.openFailedTitle}}</view>
  <view class="state-desc">{{error}}</view>
  <button class="retry-btn" bindtap="onRetry">{{c.state.retry}}</button>
</view>

<block wx:elif="{{app}}">
  <view class="runner-head">
    <view class="runner-name">{{app.name}} · {{t.runner.running}}</view>
    <view class="runner-live"><view class="chip-dot"></view>{{t.runner.sandbox}}</view>
  </view>
  <view class="runner-body">
    <view class="runner-icon">{{app.icon}}</view>
    <view class="runner-title">{{app.name}}</view>
    <view class="runner-note">{{t.runner.note}}</view>
    <view class="runner-frame" aria-hidden="true">
      <view class="runner-line w-half"></view>
      <view class="runner-line w-full"></view>
      <view class="runner-line w-3of4"></view>
      <view class="runner-cta"></view>
    </view>
  </view>
</block>
