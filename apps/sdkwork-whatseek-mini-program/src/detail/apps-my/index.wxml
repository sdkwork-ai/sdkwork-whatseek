<view class="my-head">
  <view class="page-title">{{t.my.title}}</view>
  <button class="my-create" size="mini" bindtap="onCreate">+ {{t.home.create}}</button>
</view>

<view class="my-tabs" role="tablist">
  <view class="my-tab {{tab === 'created' ? 'my-tab-active' : ''}}" data-tab="created" bindtap="onTabSwitch">{{t.my.createdTab}}</view>
  <view class="my-tab {{tab === 'favorites' ? 'my-tab-active' : ''}}" data-tab="favorites" bindtap="onTabSwitch">{{t.my.favoritesTab}}</view>
</view>

<view wx:if="{{loading}}" class="state">{{c.state.loading}}</view>

<view wx:elif="{{error}}" class="state">
  <view class="state-title">{{c.state.loadError}}</view>
  <view class="state-desc">{{error}}</view>
  <button class="retry-btn" bindtap="onRetry">{{c.state.retry}}</button>
</view>

<view wx:elif="{{tab === 'created' && apps.length === 0}}" class="state">
  <view class="state-title">{{t.my.emptyCreatedTitle}}</view>
  <view class="state-desc">{{t.my.emptyCreatedDesc}}</view>
  <button class="retry-btn" bindtap="onCreate">{{t.my.createAction}}</button>
</view>

<view wx:elif="{{tab === 'favorites' && favorites.length === 0}}" class="state">
  <view class="state-title">{{t.my.emptyFavoritesTitle}}</view>
  <view class="state-desc">{{t.my.emptyFavoritesDesc}}</view>
</view>

<block wx:else>
  <view wx:for="{{tab === 'created' ? apps : favorites}}" wx:key="id" class="panel my-item">
    <view class="row">
      <view class="row-glyph">{{item.icon}}</view>
      <view class="my-main">
        <view class="row-title">{{item.name}}<text wx:if="{{item.versionLabel}}" class="my-version">{{item.versionLabel}}</text></view>
        <view class="row-desc">{{item.requirement}}</view>
      </view>
      <view wx:if="{{tab === 'created'}}" class="badge {{item.lifecycle === 'published' ? 'badge-published' : ''}}">{{item.lifecycleLabel}}</view>
    </view>
    <view class="my-actions">
      <button class="my-action my-action-brand" size="mini" data-id="{{item.id}}" bindtap="onRun">{{t.my.run}}</button>
      <button wx:if="{{tab === 'created' && item.lifecycle !== 'published'}}" class="my-action" size="mini" data-id="{{item.id}}" bindtap="onPublish">{{t.my.publish}}</button>
      <button wx:if="{{tab === 'favorites'}}" class="my-action" size="mini" data-id="{{item.id}}" bindtap="onToggleFavorite">{{t.my.unfavorite}}</button>
      <button wx:if="{{tab === 'created'}}" class="my-action my-action-danger" size="mini" data-id="{{item.id}}" data-name="{{item.name}}" bindtap="onDelete">{{t.my.delete}}</button>
    </view>
  </view>
</block>
