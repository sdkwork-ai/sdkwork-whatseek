<view wx:if="{{loading}}" class="state">加载中…</view>

<view wx:elif="{{error}}" class="state">
  <view class="state-title">{{error}}</view>
  <button wx:if="{{error !== '合集不存在'}}" class="retry-btn" bindtap="onRetry">重试</button>
</view>

<block wx:else>
  <view class="collection-head">
    <view class="collection-title">{{collection.title}}</view>
    <view class="collection-desc">{{collection.description}}</view>
  </view>
  <view class="panel">
    <view wx:for="{{apps}}" wx:key="id" class="row">
      <view class="row-glyph">{{item.icon}}</view>
      <view class="app-main">
        <view class="row-title">{{item.name}}</view>
        <view class="row-desc">{{item.summary}}</view>
      </view>
      <navigator class="app-use" url="/detail/apps-detail/index?appId={{item.id}}">详情</navigator>
    </view>
  </view>
</block>
