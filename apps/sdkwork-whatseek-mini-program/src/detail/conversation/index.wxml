<view wx:if="{{loading}}" class="state thread-state">{{c.state.loading}}</view>

<view wx:elif="{{error}}" class="state thread-state">
  <view class="state-title">{{c.state.loadError}}</view>
  <view class="state-desc">{{error}}</view>
  <button class="retry-btn" bindtap="onRetry">{{c.state.retry}}</button>
</view>

<view wx:elif="{{messages.length === 0}}" class="state thread-state">
  <view class="state-title">{{t.conversation.emptyTitle}}</view>
  <view class="state-desc">{{t.conversation.emptyDesc}}</view>
</view>

<block wx:else>
  <scroll-view scroll-y class="thread" scroll-into-view="msg-{{messages.length - 1}}">
    <view wx:if="{{isTaskConversation && taskLink}}" class="task-link" bindtap="onViewTask">{{t.conversation.viewTask}} →</view>
    <view wx:for="{{messages}}" wx:key="id" id="msg-{{index}}" class="bubble {{item.senderId === 'me' ? 'bubble-user' : 'bubble-ai'}}">{{item.content}}</view>
  </scroll-view>
</block>

<view class="composer">
  <input class="composer-input" value="{{input}}" placeholder="{{t.conversation.inputPlaceholder}}" bindinput="onInput" confirm-type="send" bindconfirm="onSend" />
  <button class="composer-send" size="mini" disabled="{{sending || loading}}" bindtap="onSend">{{sending ? '…' : t.conversation.send}}</button>
</view>
