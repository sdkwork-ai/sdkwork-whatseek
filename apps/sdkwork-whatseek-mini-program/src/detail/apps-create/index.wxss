.create-panel { padding: 24rpx; }
.create-input { width: 100%; min-height: 160rpx; font-size: 28rpx; color: var(--sdk-color-text-primary); }
.create-error { color: var(--sdk-color-danger); padding: 0 32rpx; }
.create-actions { display: flex; flex-direction: column; gap: 16rpx; padding: 8rpx 32rpx; }
.create-modify-panel { display: flex; align-items: center; gap: 16rpx; padding: 16rpx 24rpx; }
.create-modify-input { flex: 1; font-size: 26rpx; color: var(--sdk-color-text-primary); }
.create-modify-btn {
  background: var(--sdk-color-brand);
  color: #fff;
  border-radius: 999rpx;
  font-size: 24rpx;
  padding: 0 28rpx;
}
.create-btn { width: 100%; }
.plan-value { flex: 1; text-align: right; font-size: 28rpx; color: var(--sdk-color-text-secondary); }
.plan-modules-row { align-items: flex-start; flex-wrap: wrap; }
.plan-modules { display: flex; flex-wrap: wrap; gap: 12rpx; flex: 1; justify-content: flex-end; }
.created-card { display: flex; flex-direction: column; gap: 20rpx; }
.created-head { display: flex; align-items: center; gap: 20rpx; }
.created-icon { font-size: 72rpx; }
.created-life {
  margin-top: 6rpx;
  font-size: 20rpx;
  color: var(--sdk-color-text-muted);
  border: 1rpx solid var(--sdk-color-border-subtle);
  border-radius: 999rpx;
  padding: 2rpx 14rpx;
  align-self: flex-start;
}
