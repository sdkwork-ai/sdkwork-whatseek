<!-- 第 1 步：需求输入 -->
<block wx:if="{{step === 'input'}}">
  <view class="page-title">{{t.create.inputTitle}}</view>
  <view class="page-sub">{{t.create.inputDesc}}</view>
  <view class="panel create-panel">
    <textarea class="create-input" value="{{requirement}}" bindinput="onRequirementInput" maxlength="200" placeholder="{{t.create.placeholder}}" auto-height />
  </view>
  <view wx:if="{{error}}" class="state-desc create-error">{{error}}</view>
  <view class="create-actions">
    <button class="btn-brand create-btn" disabled="{{working}}" bindtap="onDraftPlan">{{working ? t.create.planning : t.create.planAction}}</button>
  </view>
</block>

<!-- 第 2 步：方案确认 -->
<block wx:elif="{{step === 'plan'}}">
  <view class="page-title">{{t.create.planTitle}}</view>
  <view class="panel create-panel">
    <view class="row"><view class="row-title">{{t.create.appNameLabel}}</view><view class="plan-value">{{plan.title}}</view></view>
    <view class="row plan-modules-row">
      <view class="row-title">{{t.create.modulesLabel}}</view>
      <view class="plan-modules">
        <view wx:for="{{plan.modules}}" wx:key="*this" class="chip">{{item}}</view>
      </view>
    </view>
  </view>
  <view wx:if="{{error}}" class="state-desc create-error">{{error}}</view>
  <view class="create-actions">
    <button class="btn-brand create-btn" disabled="{{working}}" bindtap="onCreate">{{working ? t.create.creating : t.create.createAction}}</button>
    <button class="btn-ghost create-btn" bindtap="onRestart">{{t.create.redescribe}}</button>
  </view>
</block>

<!-- 第 3 步：创建结果 -->
<block wx:elif="{{step === 'created'}}">
  <view class="page-title">{{t.create.createdTitle}}</view>
  <view class="panel create-panel created-card">
    <view class="created-head">
      <view class="created-icon">{{app.icon}}</view>
      <view>
        <view class="row-title">{{app.name}}</view>
        <view class="created-life {{app.lifecycle === 'published' ? 'badge-published' : ''}}">{{app.lifecycle === 'published' ? t.lifecycle.published : t.lifecycle.draft}}</view>
      </view>
    </view>
    <view class="plan-modules">
      <view wx:for="{{app.modules}}" wx:key="*this" class="chip">{{item}}</view>
    </view>
  </view>
  <view wx:if="{{error}}" class="state-desc create-error">{{error}}</view>
  <view class="panel create-panel create-modify-panel">
    <input class="create-modify-input" value="{{instruction}}" bindinput="onInstructionInput" maxlength="100" placeholder="{{t.create.modifyPlaceholder}}" confirm-type="done" />
    <button class="create-modify-btn" size="mini" disabled="{{working || !instruction}}" bindtap="onModify">{{t.create.modifyAction}}</button>
  </view>
  <view class="create-actions">
    <button wx:if="{{app.lifecycle !== 'published'}}" class="btn-brand create-btn" disabled="{{working}}" bindtap="onPublish">{{working ? t.create.publishing : t.create.publishAction}}</button>
    <button class="btn-ghost create-btn" bindtap="onRun">{{t.create.runAction}}</button>
    <button class="btn-ghost create-btn" bindtap="onRestart">{{t.create.createAnother}}</button>
  </view>
</block>
