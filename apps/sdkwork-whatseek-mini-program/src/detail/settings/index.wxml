<view class="page-title">{{t.settings.title}}</view>

<view class="panel">
  <view class="row settings-block">
    <view>
      <view class="row-title">{{t.settings.darkMode}}</view>
      <view class="row-desc">{{t.settings.followSystemPrefix}}{{systemTheme === 'dark' ? t.settings.mode.dark : t.settings.mode.light}}{{t.settings.followSystemSuffix}}</view>
    </view>
  </view>
  <view class="row settings-block">
    <view class="settings-main">
      <view class="row-title">{{t.settings.language}}</view>
      <view class="row-desc">{{t.settings.languageHint}}</view>
      <view class="settings-options">
        <button class="settings-option {{locale === 'zh-CN' ? 'settings-option-active' : ''}}" size="mini" data-locale="zh-CN" bindtap="onLocale">{{t.settings.localeZh}}</button>
        <button class="settings-option {{locale === 'en-US' ? 'settings-option-active' : ''}}" size="mini" data-locale="en-US" bindtap="onLocale">{{t.settings.localeEn}}</button>
      </view>
    </view>
  </view>
</view>

<view class="panel">
  <view class="row">
    <view class="row-glyph">✨</view>
    <view>
      <view class="row-title">{{t.settings.brandTitle}}</view>
      <view class="row-desc">{{t.settings.brandMessage}}{{version}}</view>
    </view>
  </view>
  <view class="row">
    <view class="row-glyph">🔗</view>
    <view>
      <view class="row-title">{{t.settings.routeContractTitle}}</view>
      <view class="row-desc">{{t.settings.routeContractDesc}}</view>
    </view>
  </view>
</view>
