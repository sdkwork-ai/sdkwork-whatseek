<view class="search-bar">
  <input class="search-input" placeholder="搜索应用，或者直接告诉我你要做什么" value="{{query}}" bindinput="onQueryInput" confirm-type="search" bindconfirm="onSearch" focus />
  <button class="search-btn" size="mini" bindtap="onSearch">搜索</button>
</view>

<view wx:if="{{loading}}" class="state">搜索中…</view>

<view wx:elif="{{error}}" class="state">
  <view class="state-title">搜索失败</view>
  <view class="state-desc">{{error}}</view>
  <button class="retry-btn" bindtap="onRetry">重试</button>
</view>

<block wx:elif="{{searched && results.length === 0}}">
  <view class="state">
    <view class="state-title">未找到相关应用</view>
    <view class="state-desc">换个关键词试试，或者去对话页直接描述你的需求</view>
  </view>
</block>

<view wx:elif="{{results.length > 0}}" class="panel">
  <view wx:for="{{results}}" wx:key="id" class="row" data-id="{{item.id}}" bindtap="onResultTap">
    <view class="row-glyph">{{item.app.icon}}</view>
    <view class="result-main">
      <view class="row-title">{{item.app.name}}</view>
      <view class="row-desc">{{item.app.summary}}</view>
      <view class="row-reason">匹配：{{item.reason}}</view>
    </view>
    <view class="row-arrow">›</view>
  </view>
</view>
