<view class="search-bar">
  <input class="search-input" placeholder="{{t.home.searchPlaceholder}}" value="{{query}}" bindinput="onQueryInput" confirm-type="search" bindconfirm="onSearch" focus />
  <button class="search-btn" size="mini" bindtap="onSearch">{{t.home.search}}</button>
</view>

<view wx:if="{{suggestions.length > 0}}" class="panel">
  <view wx:for="{{suggestions}}" wx:key="*this" class="row" data-term="{{item}}" bindtap="onSuggestionTap">
    <view class="row-glyph">🔍</view>
    <view class="result-main"><view class="row-title">{{item}}</view></view>
  </view>
</view>

<view wx:if="{{!searched && trending.length > 0}}" class="panel">
  <view class="section-title">{{t.search.trending}}</view>
  <view class="trending-chips">
    <view wx:for="{{trending}}" wx:key="*this" class="badge" data-term="{{item}}" bindtap="onTrendingTap">{{item}}</view>
  </view>
</view>

<view wx:if="{{loading}}" class="state">{{t.search.searching}}</view>

<view wx:elif="{{error}}" class="state">
  <view class="state-title">{{t.search.failed}}</view>
  <view class="state-desc">{{error}}</view>
  <button class="retry-btn" bindtap="onRetry">{{c.state.retry}}</button>
</view>

<block wx:elif="{{searched && results.length === 0}}">
  <view class="state">
    <view class="state-title">{{t.search.emptyTitle}}</view>
    <view class="state-desc">{{t.search.emptyDesc}}</view>
  </view>
</block>

<view wx:elif="{{results.length > 0}}" class="panel">
  <view wx:for="{{results}}" wx:key="id" class="row" data-id="{{item.id}}" bindtap="onResultTap">
    <view class="row-glyph">{{item.app.icon}}</view>
    <view class="result-main">
      <view class="row-title">{{item.app.name}}</view>
      <view class="row-desc">{{item.app.summary}}</view>
      <view class="row-meta">{{item.app.category}} · ⭐ {{item.app.rating}} · {{item.app.usersLabel}} · {{item.app.priceLabel}}{{item.app.aiCapability ? ' · AI' : ''}}</view>
      <view class="row-reason">{{t.search.matchedPrefix}}{{item.reason}}</view>
    </view>
    <view class="row-arrow">›</view>
  </view>
</view>
