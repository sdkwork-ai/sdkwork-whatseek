<view wx:if="{{loading}}" class="state">{{c.state.loading}}</view>

<view wx:elif="{{error}}" class="state">
  <view class="state-title">{{t.detail.openFailedTitle}}</view>
  <view class="state-desc">{{error}}</view>
  <button class="retry-btn" bindtap="onRetry">{{c.state.retry}}</button>
</view>

<block wx:elif="{{contact}}">
  <view class="panel contact-card">
    <view class="contact-avatar">{{contact.avatar}}</view>
    <view class="contact-name">{{contact.name}}</view>
    <view class="chip">{{kindLabel}}</view>
  </view>

  <view class="panel">
    <view class="row"><view class="row-title">{{t.detail.bio}}</view><view class="contact-value">{{contact.bio}}</view></view>
    <view wx:if="{{contact.company}}" class="row"><view class="row-title">{{t.detail.company}}</view><view class="contact-value">{{contact.company}}</view></view>
    <view class="row contact-tags-row">
      <view class="row-title">{{t.detail.tags}}</view>
      <view class="contact-tags">
        <view wx:for="{{contact.tags}}" wx:key="*this" class="badge">{{item}}</view>
      </view>
    </view>
  </view>

  <view class="contact-actions">
    <button class="btn-brand contact-btn" disabled="{{opening}}" bindtap="onSendMessage">{{opening ? t.detail.opening : t.detail.sendMessage}}</button>
  </view>
</block>
