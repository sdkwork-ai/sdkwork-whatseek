<view wx:if="{{loading}}" class="state">加载中…</view>

<view wx:elif="{{error}}" class="state">
  <view class="state-title">无法打开联系人</view>
  <view class="state-desc">{{error}}</view>
  <button class="retry-btn" bindtap="onRetry">重试</button>
</view>

<block wx:elif="{{contact}}">
  <view class="panel contact-card">
    <view class="contact-avatar">{{contact.avatar}}</view>
    <view class="contact-name">{{contact.name}}</view>
    <view class="chip">{{kindLabel}}</view>
  </view>

  <view class="panel">
    <view class="row"><view class="row-title">简介</view><view class="contact-value">{{contact.bio}}</view></view>
    <view wx:if="{{contact.company}}" class="row"><view class="row-title">公司</view><view class="contact-value">{{contact.company}}</view></view>
    <view class="row contact-tags-row">
      <view class="row-title">标签</view>
      <view class="contact-tags">
        <view wx:for="{{contact.tags}}" wx:key="*this" class="badge">{{item}}</view>
      </view>
    </view>
  </view>

  <view class="contact-actions">
    <button class="btn-brand contact-btn" disabled="{{opening}}" bindtap="onSendMessage">{{opening ? '打开会话…' : '发消息'}}</button>
  </view>
</block>
