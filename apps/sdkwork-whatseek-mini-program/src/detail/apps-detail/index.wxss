.detail-head { display: flex; align-items: center; gap: 24rpx; padding: 40rpx 32rpx 16rpx; }
.detail-icon { font-size: 80rpx; }
.detail-tags { display: flex; flex-wrap: wrap; gap: 12rpx; padding: 0 32rpx 16rpx; }
.detail-card { padding: 24rpx; }
.detail-btn { margin: 24rpx 24rpx; }
.detail-fav { text-align: center; color: var(--sdk-color-text-secondary); font-size: 26rpx; padding: 12rpx; }
.detail-fav-active { color: var(--sdk-color-brand); }

.badge-ai { color: var(--sdk-color-brand); border-color: var(--sdk-color-brand); }

.detail-section-title { font-size: 28rpx; font-weight: 600; color: var(--sdk-color-text-primary); margin-top: 20rpx; }

.detail-shots { display: flex; gap: 12rpx; margin-top: 12rpx; }

.detail-shot {
  width: 160rpx;
  height: 224rpx;
  border-radius: 16rpx;
  background: var(--sdk-color-surface-canvas);
  border: 1rpx solid var(--sdk-color-border-subtle);
}
