<view wx:if="{{loading}}" class="state">{{c.state.loading}}</view>

<view wx:elif="{{error}}" class="state">
  <view class="state-title">{{t.detail.openFailedTitle}}</view>
  <view class="state-desc">{{error}}</view>
  <button class="retry-btn" bindtap="onRetry">{{c.state.retry}}</button>
</view>

<view wx:elif="{{app}}" class="detail">
  <view class="detail-head">
    <view class="detail-icon">{{app.icon}}</view>
    <view>
      <view class="row-title">{{app.name}}</view>
      <view class="row-desc">{{app.developer}} · {{app.category}} · {{app.priceLabel}} · ⭐ {{app.rating}}</view>
      <view class="row-desc">{{app.usersLabel}} {{t.detail.users}} · {{t.detail.updated}} {{app.updatedAt}}<block wx:if="{{app.currentVersion}}"> · v{{app.currentVersion}}</block></view>
    </view>
  </view>
  <view class="detail-tags">
    <view wx:if="{{app.aiCapability}}" class="badge badge-ai">{{t.detail.aiCapability}}</view>
    <view wx:for="{{app.tags}}" wx:key="*this" class="badge">{{item}}</view>
  </view>
  <view class="panel detail-card">
    <view class="detail-section-title">{{t.detail.screenshots}}</view>
    <view class="detail-shots" wx:if="{{app.screenshots.length > 0}}">
      <image wx:for="{{app.screenshots}}" wx:key="*this" class="detail-shot" src="{{item}}" mode="aspectFill" lazy-load="{{true}}" />
    </view>
    <view class="detail-shots" wx:else>
      <view class="detail-shot"></view>
      <view class="detail-shot"></view>
      <view class="detail-shot"></view>
    </view>
    <view wx:if="{{app.whatsNew}}" class="row-desc">{{app.whatsNew}}</view>
    <view class="detail-section-title">{{app.priceLabel}}</view>
    <view class="detail-section-title">{{t.detail.permissions}}</view>
    <view wx:if="{{app.permissions.length === 0}}" class="row-desc">{{t.detail.noPermissions}}</view>
    <view wx:for="{{app.permissions}}" wx:key="*this" class="row-desc">· {{item}}</view>
    <view wx:if="{{similar.length > 0}}" class="detail-section-title">{{t.detail.similar}}</view>
    <view wx:for="{{similar}}" wx:key="id" class="row" data-id="{{item.id}}" bindtap="onSimilarTap">
      <view class="row-glyph">{{item.icon}}</view>
      <view class="result-main">
        <view class="row-title">{{item.name}}</view>
        <view class="row-desc">⭐ {{item.rating}} · {{item.priceLabel}}</view>
      </view>
    </view>
    <view wx:if="{{developerApps.length > 0}}" class="detail-section-title">{{t.detail.developerApps}}</view>
    <view wx:for="{{developerApps}}" wx:key="id" class="row" data-id="{{item.id}}" bindtap="onSimilarTap">
      <view class="row-glyph">{{item.icon}}</view>
      <view class="result-main">
        <view class="row-title">{{item.name}}</view>
        <view class="row-desc">⭐ {{item.rating}} · {{item.priceLabel}}</view>
      </view>
    </view>
    <view wx:if="{{reviews.length > 0}}" class="detail-section-title">{{t.detail.reviews}}</view>
    <view wx:for="{{reviews}}" wx:key="id" class="review-row">
      <view class="row-desc">⭐ {{item.rating}} · {{item.author}} · {{item.createdAt}}</view>
      <view wx:if="{{item.title}}" class="row-title">{{item.title}}</view>
    </view>
  </view>
  <button class="btn-brand detail-btn" bindtap="onUse">{{t.detail.use}}</button>
  <button class="detail-fav {{favorite ? 'detail-fav-active' : ''}}" disabled="{{favoriting}}" bindtap="onFavorite">
    {{favorite ? '★ ' + t.detail.favorited : '☆ ' + t.detail.favorite}}{{favoriting ? '…' : ''}}
  </button>
</view>
