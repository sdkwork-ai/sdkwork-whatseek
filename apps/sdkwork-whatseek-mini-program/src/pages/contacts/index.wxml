<view class="page-title">{{t.home.title}}</view>
<view class="page-sub">{{t.home.subtitle}}</view>

<view class="search-bar">
  <input class="search-input" placeholder="{{t.home.searchPlaceholder}}" value="{{query}}" bindinput="onQueryInput" confirm-type="search" bindconfirm="onSearch" />
  <button class="search-btn" size="mini" bindtap="onSearch">{{t.home.search}}</button>
</view>

<view class="segs">
  <view wx:for="{{segments}}" wx:key="id" class="seg {{segment === item.id ? 'seg-active' : ''}}" data-id="{{item.id}}" bindtap="onSegmentTap">{{item.label}}</view>
</view>

<view wx:if="{{loading}}" class="state">{{c.state.loading}}</view>

<view wx:elif="{{error}}" class="state">
  <view class="state-title">{{c.state.loadError}}</view>
  <view class="state-desc">{{error}}</view>
  <button class="retry-btn" bindtap="onRetry">{{c.state.retry}}</button>
</view>

<view wx:elif="{{contacts.length === 0}}" class="state">
  <view class="state-title">{{t.home.emptyTitle}}</view>
  <view class="state-desc">{{t.home.emptyDesc}}</view>
</view>

<view wx:else class="panel">
  <view wx:for="{{contacts}}" wx:key="id" class="row" data-id="{{item.id}}" bindtap="onContactTap">
    <view class="row-glyph">{{item.avatar}}</view>
    <view class="contact-main">
      <view class="row-title">{{item.name}}</view>
      <view class="row-desc">{{item.bio}}</view>
    </view>
    <view class="row-arrow">›</view>
  </view>
</view>
