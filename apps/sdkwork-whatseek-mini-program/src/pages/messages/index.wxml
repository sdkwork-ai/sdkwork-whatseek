<view class="page-title">{{t.home.title}}</view>
<view class="page-sub">{{t.home.subtitle}}</view>

<view wx:if="{{loading}}" class="state">{{c.state.loading}}</view>

<view wx:elif="{{error}}" class="state">
  <view class="state-title">{{c.state.loadError}}</view>
  <view class="state-desc">{{error}}</view>
  <button class="retry-btn" bindtap="onRetry">{{c.state.retry}}</button>
</view>

<view wx:elif="{{conversations.length === 0}}" class="state">
  <view class="state-title">{{t.home.emptyTitle}}</view>
  <view class="state-desc">{{t.home.emptyDesc}}</view>
</view>

<view wx:else class="panel">
  <view wx:for="{{conversations}}" wx:key="id" class="row" data-id="{{item.id}}" bindtap="onConversationTap">
    <view class="contact-main">
      <view class="row-title">{{item.title}}</view>
      <view class="row-desc">{{item.lastMessagePreview}}</view>
    </view>
    <view wx:if="{{item.unread > 0}}" class="unread">{{item.unread}}</view>
    <view class="row-arrow">›</view>
  </view>
</view>
