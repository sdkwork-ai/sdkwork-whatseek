<scroll-view scroll-y class="thread" scroll-into-view="thread-bottom">
  <block wx:if="{{entries.length === 0}}">
    <view class="hero">
      <view class="hero-title">{{t.home.heroTitle}}</view>
      <view class="hero-sub">{{t.home.heroSubtitle}}</view>
    </view>
    <view class="suggestions">
      <button
        wx:for="{{suggestionKeys}}"
        wx:key="*this"
        class="suggestion"
        data-text="{{item}}"
        bindtap="onSuggestion"
      >{{item}}</button>
    </view>
  </block>

  <block wx:for="{{entries}}" wx:key="index" wx:for-index="entryIndex">
    <view class="bubble {{item.role === 'user' ? 'bubble-user' : 'bubble-ai'}}">{{item.text}}</view>

    <view wx:if="{{item.taskId}}" class="task-chip-row">
      <view class="chip" data-entryindex="{{entryIndex}}" bindtap="onTaskTap">
        <view class="chip-dot"></view>
        <text>{{item.taskState || t.page.taskCreatedHint}}</text>
      </view>
      <view wx:if="{{item.taskWaiting}}" class="task-actions">
        <button class="task-action task-action-confirm" size="mini" data-kind="confirm" data-entryindex="{{entryIndex}}" bindtap="onTaskAction">{{t.taskAction.confirm}}</button>
        <button class="task-action task-action-cancel" size="mini" data-kind="cancel" data-entryindex="{{entryIndex}}" bindtap="onTaskAction">{{t.taskAction.cancel}}</button>
      </view>
    </view>

    <block wx:if="{{item.cards}}">
      <view class="panel card" wx:if="{{item.cards.plan}}">
        <view class="row-title">{{item.cards.plan.title}}</view>
        <view class="plan-modules">
          <view wx:for="{{item.cards.plan.modules}}" wx:for-item="mod" wx:key="*this" class="plan-module">✓ {{mod}}</view>
        </view>
        <view class="row-title card-plan-label">{{t.card.planPages}}</view>
        <view class="plan-modules">
          <view wx:for="{{item.cards.plan.pages}}" wx:for-item="pageName" wx:key="*this" class="plan-module">✓ {{pageName}}</view>
        </view>
        <view class="row-title card-plan-label">{{t.card.planDataModel}}</view>
        <view class="plan-modules">
          <view wx:for="{{item.cards.plan.dataModel}}" wx:for-item="entity" wx:key="*this" class="plan-module">✓ {{entity}}</view>
        </view>
        <button class="btn-brand" data-kind="generate" data-entryindex="{{entryIndex}}" bindtap="onAction">{{t.card.generateNow}}</button>
      </view>

      <view class="panel card" wx:if="{{item.cards.sendMessage}}">
        <view class="row-title">{{t.card.sendToPrefix}} {{item.cards.sendMessage.contactName}}{{t.card.sendToSuffix}}</view>
        <view class="draft">{{item.cards.sendMessage.draft}}</view>
        <button
          class="btn-brand"
          data-kind="send"
          data-contactid="{{item.cards.sendMessage.contactId}}"
          data-contactname="{{item.cards.sendMessage.contactName}}"
          data-draft="{{item.cards.sendMessage.draft}}"
          bindtap="onAction"
        >{{t.card.confirmSend}}</button>
        <view class="confirm-note">{{t.card.confirmNote}}</view>
      </view>

      <view class="panel card" wx:if="{{item.cards.apps.length > 0}}">
        <view wx:for="{{item.cards.apps}}" wx:for-item="app" wx:key="id" class="row">
          <view class="app-main">
            <view class="row-title">{{app.name}}</view>
            <view class="row-desc">{{app.summary}}</view>
            <view class="app-reason">{{t.card.matched}}{{app.reason}} · {{app.priceLabel}}{{app.aiCapability ? ' · ' + t.card.aiCapability : ''}}</view>
          </view>
          <navigator class="app-use" url="/detail/apps-detail/index?appId={{app.id}}">{{t.card.use}}</navigator>
        </view>
      </view>

      <view class="panel card" wx:if="{{item.cards.contacts.length > 0}}">
        <view wx:for="{{item.cards.contacts}}" wx:for-item="contact" wx:key="id" class="row" data-id="{{contact.id}}" bindtap="onContactTap">
          <view class="app-main">
            <view class="row-title">{{contact.name}}</view>
            <view class="row-desc">{{contact.bio}}</view>
          </view>
          <view class="row-arrow">›</view>
        </view>
      </view>

      <view class="panel card" wx:if="{{item.cards.commerce}}">
        <view class="row-title">{{item.cards.commerce.domain}} · {{t.card.commerceFound}}</view>
        <view wx:for="{{item.cards.commerce.items}}" wx:for-item="item2" wx:key="id" class="row">
          <view class="app-main">
            <view class="row-title">{{item2.title}}</view>
            <view class="row-desc">{{item2.subtitle}}</view>
          </view>
          <view class="commerce-price">{{item2.priceLabel}}</view>
        </view>
      </view>
    </block>
  </block>

  <view wx:if="{{sending}}" class="bubble bubble-ai">{{t.home.thinking}}</view>
  <view id="thread-bottom"></view>
</scroll-view>

<view class="composer">
  <input
    class="composer-input"
    value="{{input}}"
    placeholder="{{t.home.inputPlaceholder}}"
    bindinput="onInput"
    confirm-type="send"
    bindconfirm="onSend"
  />
  <button class="composer-send" size="mini" bindtap="onSend" disabled="{{sending}}">{{t.home.send}}</button>
</view>
