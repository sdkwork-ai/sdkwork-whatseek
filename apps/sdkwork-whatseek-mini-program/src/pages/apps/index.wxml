<view class="apps-head">
  <view class="page-title">{{t.home.title}}</view>
  <button class="apps-create" size="mini" bindtap="onCreate">+ {{t.home.create}}</button>
</view>

<view class="search-bar">
  <input class="search-input" placeholder="{{t.home.searchPlaceholder}}" value="{{query}}" bindinput="onQueryInput" confirm-type="search" bindconfirm="onSearch" />
  <button class="search-btn" size="mini" bindtap="onSearch">{{t.home.search}}</button>
</view>

<view class="cats">
  <view wx:for="{{categories}}" wx:key="id" class="cat" data-id="{{item.id}}" bindtap="onCategoryTap">{{item.icon}} {{item.id}}</view>
</view>

<view wx:if="{{loading}}" class="state">{{c.state.loading}}</view>

<view wx:elif="{{error}}" class="state">
  <view class="state-title">{{c.state.loadError}}</view>
  <view class="state-desc">{{error}}</view>
  <button class="retry-btn" bindtap="onRetry">{{c.state.retry}}</button>
</view>

<block wx:else>
  <view class="apps-entries">
    <view class="row apps-entry" bindtap="onMyApps">
      <view class="row-glyph">🧩</view>
      <view class="apps-entry-main">
        <view class="row-title">{{t.home.myApps}}</view>
        <view class="row-desc">{{t.home.myAppsDesc}}</view>
      </view>
      <view class="row-arrow">›</view>
    </view>
  </view>

  <block wx:if="{{feed}}">
    <swiper wx:if="{{feed.heroes.length > 0}}" class="feed-heroes" indicator-dots autoplay circular interval="5000">
      <swiper-item wx:for="{{feed.heroes}}" wx:key="id" data-appid="{{item.appId}}" bindtap="onHeroTap">
        <view class="feed-hero">
          <view class="feed-hero-badge">{{item.badge}}</view>
          <view class="feed-hero-icon">{{item.icon}}</view>
          <view class="feed-hero-main">
            <view class="feed-hero-title">{{item.title}}</view>
            <view class="feed-hero-tagline">{{item.tagline}}</view>
          </view>
        </view>
      </swiper-item>
    </swiper>

    <view wx:if="{{feed.stories.length > 0}}" class="page-sub">{{t.home.stories}}</view>
    <scroll-view wx:if="{{feed.stories.length > 0}}" scroll-x class="feed-strip">
      <view wx:for="{{feed.stories}}" wx:key="id" class="feed-story" data-appid="{{item.appId}}" bindtap="onStoryTap">
        <view class="feed-story-icon">{{item.icon}}</view>
        <view class="feed-story-title">{{item.title}}</view>
        <view class="feed-story-sub">{{item.subtitle}}</view>
      </view>
    </scroll-view>

    <view wx:if="{{feed.collections.length > 0}}" class="page-sub">{{t.home.collections}}</view>
    <scroll-view wx:if="{{feed.collections.length > 0}}" scroll-x class="feed-strip">
      <view wx:for="{{feed.collections}}" wx:key="id" class="feed-collection" data-id="{{item.id}}" bindtap="onCollectionTap">
        <view class="feed-collection-title">{{item.title}}</view>
        <view class="feed-collection-desc">{{item.description}}</view>
        <view class="feed-collection-icons">
          <text wx:for="{{item.coverApps}}" wx:for-item="cover" wx:key="id">{{cover.icon}}</text>
        </view>
      </view>
    </scroll-view>
  </block>

  <view class="page-sub">{{t.home.recommended}} · {{t.home.countPrefix}}{{recommended.length}}{{t.home.countSuffix}}</view>
  <view class="panel">
    <view wx:for="{{recommended}}" wx:key="id" class="row">
      <view class="row-glyph">{{item.icon}}</view>
      <view class="app-main">
        <view class="row-title">{{item.name}}</view>
        <view class="row-desc">{{item.summary}}</view>
      </view>
      <navigator class="app-use" url="/detail/apps-detail/index?appId={{item.id}}">{{t.row.detail}}</navigator>
    </view>
  </view>

  <view wx:if="{{hot.length > 0}}" class="page-sub">{{t.home.hot}}</view>
  <view wx:if="{{hot.length > 0}}" class="panel">
    <view wx:for="{{hot}}" wx:key="id" class="row">
      <view class="row-glyph">{{item.icon}}</view>
      <view class="app-main">
        <view class="row-title">{{item.name}}</view>
        <view class="row-desc">{{item.usersLabel}} {{t.tile.inUse}} · {{item.priceLabel}}</view>
      </view>
      <navigator class="app-use" url="/detail/apps-detail/index?appId={{item.id}}">{{t.row.detail}}</navigator>
    </view>
  </view>

  <block wx:if="{{feed && feed.charts.length > 0}}">
    <view class="page-sub">{{t.home.charts}}</view>
    <view wx:for="{{feed.charts}}" wx:key="id" class="panel feed-chart">
      <view class="feed-chart-head">
        <view class="feed-chart-title">{{t.chart[item.id]}}</view>
        <view class="feed-chart-more" bindtap="onCharts">{{t.home.chartsMore}} ›</view>
      </view>
      <view wx:for="{{item.apps}}" wx:for-item="app" wx:key="id" class="row">
        <view class="row-glyph">{{app.icon}}</view>
        <view class="app-main">
          <view class="row-title">{{app.name}}</view>
          <view class="row-desc">{{app.usersLabel}} {{t.tile.inUse}} · {{app.priceLabel}}</view>
        </view>
        <navigator class="app-use" url="/detail/apps-detail/index?appId={{app.id}}">{{t.row.detail}}</navigator>
      </view>
    </view>
  </block>

  <view wx:if="{{recents.length > 0}}" class="page-sub">{{t.home.recent}}</view>
  <view wx:if="{{recents.length > 0}}" class="panel">
    <view wx:for="{{recents}}" wx:key="id" class="row">
      <view class="row-glyph">{{item.icon}}</view>
      <view class="app-main">
        <view class="row-title">{{item.name}}</view>
        <view class="row-desc">{{item.summary}}</view>
      </view>
      <navigator class="app-use" url="/detail/apps-detail/index?appId={{item.id}}">{{t.row.detail}}</navigator>
    </view>
  </view>
</block>
