{
  "pages": [
    "pages/chat/index",
    "pages/apps/index",
    "pages/contacts/index",
    "pages/messages/index",
    "pages/profile/index"
  ],
  "subPackages": [
    {
      "root": "detail",
      "pages": [
        "apps-detail/index",
        "apps-search/index",
        "apps-runner/index",
        "apps-create/index",
        "apps-my/index",
        "contact-detail/index",
        "conversation/index",
        "settings/index"
      ]
    }
  ],
  "window": {
    "navigationBarTitleText": "问寻 WhatSeek",
    "navigationBarBackgroundColor": "@navBg",
    "navigationBarTextStyle": "@navTxt",
    "backgroundColor": "@bg"
  },
  "tabBar": {
    "color": "@tabColor",
    "selectedColor": "@tabSelected",
    "backgroundColor": "@tabBg",
    "borderStyle": "@tabBorder",
    "list": [
      {
        "pagePath": "pages/chat/index",
        "text": "对话"
      },
      {
        "pagePath": "pages/apps/index",
        "text": "应用"
      },
      {
        "pagePath": "pages/contacts/index",
        "text": "通讯录"
      },
      {
        "pagePath": "pages/messages/index",
        "text": "消息"
      },
      {
        "pagePath": "pages/profile/index",
        "text": "我的"
      }
    ]
  },
  "darkmode": true,
  "themeLocation": "theme.json",
  "lazyCodeLoading": "requiredComponents",
  "sitemapLocation": "sitemap.json"
}
