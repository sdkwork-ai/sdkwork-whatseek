{
  "pages": [
    "pages/chat/index",
    "pages/apps/index",
    "pages/contacts/index",
    "pages/messages/index",
    "pages/profile/index"
  ],
  "subPackages": [
    {
      "root": "detail",
      "pages": [
        "apps-detail/index",
        "apps-search/index",
        "apps-runner/index",
        "apps-create/index",
        "apps-my/index",
        "contact-detail/index",
        "conversation/index",
        "settings/index"
      ]
    }
  ],
  "window": {
    "navigationBarTitleText": "问寻 WhatSeek",
    "navigationBarBackgroundColor": "@navBg",
    "navigationBarTextStyle": "@navTxt",
    "backgroundColor": "@bg"
  },
  "tabBar": {
    "color": "@tabColor",
    "selectedColor": "@tabSelected",
    "backgroundColor": "@tabBg",
    "borderStyle": "@tabBorder",
    "list": [
      {
        "pagePath": "pages/chat/index",
        "text": "对话",
        "iconPath": "assets/tabbar/chat-outline.png",
        "selectedIconPath": "assets/tabbar/chat-filled.png"
      },
      {
        "pagePath": "pages/apps/index",
        "text": "应用",
        "iconPath": "assets/tabbar/apps-outline.png",
        "selectedIconPath": "assets/tabbar/apps-filled.png"
      },
      {
        "pagePath": "pages/contacts/index",
        "text": "通讯录",
        "iconPath": "assets/tabbar/contacts-outline.png",
        "selectedIconPath": "assets/tabbar/contacts-filled.png"
      },
      {
        "pagePath": "pages/messages/index",
        "text": "消息",
        "iconPath": "assets/tabbar/messages-outline.png",
        "selectedIconPath": "assets/tabbar/messages-filled.png"
      },
      {
        "pagePath": "pages/profile/index",
        "text": "我的",
        "iconPath": "assets/tabbar/profile-outline.png",
        "selectedIconPath": "assets/tabbar/profile-filled.png"
      }
    ]
  },
  "darkmode": true,
  "themeLocation": "theme.json",
  "lazyCodeLoading": "requiredComponents",
  "sitemapLocation": "sitemap.json"
}
