{
  "name": "sdkwork-whatseek-mini-program",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm dev:standalone",
    "dev:standalone": "node scripts/build-runtime.mjs --deployment-profile standalone --environment development --watch",
    "dev:cloud": "node scripts/build-runtime.mjs --deployment-profile standalone --environment development --watch",
    "build": "node scripts/build-runtime.mjs --deployment-profile standalone --environment development",
    "build:standalone": "node scripts/build-runtime.mjs --deployment-profile standalone --environment development",
    "build:cloud": "node scripts/build-runtime.mjs --deployment-profile standalone --environment development",
    "build:mini-program": "node scripts/build-runtime.mjs --deployment-profile standalone --environment development",
    "build:mini-program:staging": "node scripts/build-runtime.mjs --deployment-profile standalone --environment staging",
    "build:mini-program:prod": "node scripts/build-runtime.mjs --deployment-profile standalone --environment production",
    "preview:mini-program": "echo \"Open the WeChat DevTools with miniprogramRoot=src/ (see project.config.json); the runtime bundle must be built first: pnpm build\"",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node scripts/build-runtime.mjs --deployment-profile standalone --environment development && node --test tests/mini-program-surface-contract.test.mjs tests/mini-program-page-behavior.test.mjs tests/mini-program-im-transport.test.mjs",
    "clean": "node -e \"import('node:fs').then(fs => { for (const p of ['src/runtime/app.js','src/runtime/runtime-env.js']) fs.rmSync(p, { force: true }); })\""
  },
  "dependencies": {
    "@sdkwork/appstore-app-sdk": "workspace:*",
    "@sdkwork/im-sdk": "workspace:*",
    "@sdkwork/sdk-common": "workspace:*",
    "@sdkwork/whatseek-intent-core": "workspace:*",
    "@sdkwork/whatseek-mp-apps": "workspace:*",
    "@sdkwork/whatseek-mp-chat": "workspace:*",
    "@sdkwork/whatseek-mp-commons": "workspace:*",
    "@sdkwork/whatseek-mp-contacts": "workspace:*",
    "@sdkwork/whatseek-mp-core": "workspace:*",
    "@sdkwork/whatseek-mp-messages": "workspace:*",
    "@sdkwork/whatseek-mp-profile": "workspace:*",
    "@sdkwork/whatseek-mp-shell": "workspace:*",
    "@sdkwork/whatseek-route-core": "workspace:*",
    "@sdkwork/whatseek-service-core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24.9.2",
    "esbuild": "catalog:",
    "miniprogram-api-typings": "catalog:",
    "typescript": "catalog:"
  }
}
