{
  "schemaVersion": "2026-06-06.sdkwork.workflow.v1",
  "app": {
    "id": "sdkwork-whatseek",
    "name": "WhatSeek",
    "repository": "sdkwork-ai/sdkwork-whatseek",
    "sourcePath": ".",
    "configPath": "sdkwork.app.config.json"
  },
  "release": {
    "artifactPrefix": "sdkwork-whatseek",
    "defaultVersion": "0.1.0",
    "changelog": {
      "source": "app-manifest",
      "maxCommitSubjects": 50
    }
  },
  "dependencies": [
    {
      "id": "sdkwork-im",
      "repository": "sdkwork-ai/sdkwork-im",
      "refInput": "SDKWORK_IM_REF",
      "tokenSecret": "SDKWORK_RELEASE_TOKEN"
    },
    {
      "id": "sdkwork-sdk-commons",
      "repository": "sdkwork-ai/sdkwork-sdk-commons",
      "refInput": "SDKWORK_SDK_COMMONS_REF",
      "tokenSecret": "SDKWORK_RELEASE_TOKEN"
    },
    {
      "id": "sdkwork-utils",
      "repository": "sdkwork-ai/sdkwork-utils",
      "refInput": "SDKWORK_UTILS_REF",
      "tokenSecret": "SDKWORK_RELEASE_TOKEN"
    },
    {
      "id": "sdkwork-web-framework",
      "repository": "sdkwork-ai/sdkwork-web-framework",
      "refInput": "SDKWORK_WEB_FRAMEWORK_REF",
      "tokenSecret": "SDKWORK_RELEASE_TOKEN"
    }
  ],
  "verificationDependencies": [],
  "targets": [
    {
      "id": "browser-universal-standalone-h5-tar-gz",
      "profileBinding": "fixed",
      "deploymentProfile": "standalone",
      "runtimeTarget": "browser",
      "profile": "browser",
      "platform": "browser",
      "architecture": "universal",
      "variant": "h5",
      "formats": [
        "tar.gz"
      ],
      "runner": "ubuntu-24.04",
      "outputGlobs": [
        "dist/release-packages/sdkwork-whatseek-browser-universal-standalone-h5-tar-gz-0.1.0.tar.gz",
        "dist/release-evidence/browser-universal-standalone-h5-tar-gz/*"
      ],
      "artifactPath": "dist/release-packages/sdkwork-whatseek-browser-universal-standalone-h5-tar-gz-0.1.0.tar.gz"
    },
    {
      "id": "pc-browser-universal-standalone-h5-tar-gz",
      "profileBinding": "fixed",
      "deploymentProfile": "standalone",
      "runtimeTarget": "browser",
      "profile": "browser",
      "platform": "browser",
      "architecture": "universal",
      "variant": "pc",
      "formats": [
        "tar.gz"
      ],
      "runner": "ubuntu-24.04",
      "outputGlobs": [
        "dist/release-packages/sdkwork-whatseek-pc-browser-universal-standalone-tar-gz-0.1.0.tar.gz",
        "dist/release-evidence/pc-browser-universal-standalone-tar-gz/*"
      ],
      "artifactPath": "dist/release-packages/sdkwork-whatseek-pc-browser-universal-standalone-tar-gz-0.1.0.tar.gz"
    }
  ],
  "security": {
    "artifactAttestations": true,
    "sbomRequired": true,
    "signingRequired": false
  },
  "publish": {
    "workflowArtifact": true,
    "githubRelease": false,
    "retentionDays": 30
  },
  "deployments": []
}
